// 类：字段装在实例上，方法共享在类上；this 指当前实例，super 调父类方法

// 1) 构造（init）与字段、方法
class 茶 {
    init(名字, 年份) {
        this.名字 = 名字;
        this.年份 = 年份;
    }
    介绍() {
        return "${this.名字}，${this.年份} 年的茶";
    }
    陈化(年数) {
        this.年份 += 年数;
        return this; // 返回自己，方便接着点
    }
}

var 龙井 = 茶("龙井", 2024);
print(龙井.介绍());
print(龙井.陈化(2).介绍());
print(龙井.名字, 龙井["年份"]);

// 2) 每个实例有自己的字段；方法取出来也记得自己的接收者
var 又一份 = 茶("龙井", 2020);
var 读 = 龙井.介绍;
print(又一份.介绍());
print(读());

// 3) 继承与 super：子类覆写方法，用 super 保留父类那一段
class 普洱 < 茶 {
    介绍() {
        return super.介绍() + "（越陈越香）";
    }
}
print(普洱("熟普", 2015).介绍());

// 4) 子类不写 init 就继承父类的 init
class 礼物 < 普洱 { }
var 礼 = 礼物("小罐茶", 2010);
print(礼.介绍());

// 5) 类也是值：可以传参、可以放进数组
fn 两杯(类) {
    return [类("A", 2000), 类("B", 2001)];
}
var 杯 = 两杯(茶);
print(杯[0].介绍(), "|", 杯[1].介绍());

// 6) 类可以声明在函数里，方法捕获类名（递归）与外层变量
fn 数数(上限) {
    class 链 {
        init(n) { this.n = n; }
        走() {
            if (this.n >= 上限) return this.n;
            return 链(this.n + 1).走();
        }
    }
    return 链(0).走();
}
print("数到", 数数(4));

// 7) 属性不存在是运行时错误，catch 能接住
try {
    print(龙井.产地);
} catch (消息) {
    print("查不到：", 消息);
}
print("程序继续");
