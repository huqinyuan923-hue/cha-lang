// try/catch：错误也是一种值，throw 把它扔出去，catch 把它接住
fn 安全除法(a, b) {
    if (b == 0) throw {"错误码": "除零", "算式": "${a} / ${b}"};
    return a / b;
}

// 1) try 体没出错，catch 一眼都不看
try {
    print(安全除法(10, 2));
    print("这行照跑：try 体一路走到底");
} catch (结果) {
    print("这行不跑：没有错，catch 轮不到");
}

// 2) 接住自己 throw 的值：catch 到的就是原样那个值
try {
    print(安全除法(10, 0));
} catch (结果) {
    print(结果["错误码"], 结果["算式"]);
}

// 3) 运行时自己冒出来的错也能接住，接到的是那句中文错误消息
var 列表 = [1, 2, 3];
try {
    print(列表[10]);
} catch (消息) {
    print("接住了：", 消息);
}

// 4) 跨函数传播：错在内层函数里抛，外层调用者接住，自己的变量一个不少
fn 读配置(名字) {
    var 表 = {"茶": 60, "咖啡": 30};
    var 价 = 表[名字];
    if (价 == nil) throw "没有这项：${名字}";
    return 价;
}

fn 报价(名字) {
    try {
        return "${名字}：${读配置(名字)} 元";
    } catch (消息) {
        return "${名字}：报价失败（${消息}）";
    }
}

print(报价("茶"));
print(报价("可乐"));

// 5) 循环里出错，处理完继续跑，不用整个程序陪葬
for (var i = 0; i < 5; i += 1) {
    try {
        print("第 ${i} 轮：", 读配置(i == 2 ? "奶茶" : "茶"));
    } catch (消息) {
        print("第 ${i} 轮跳过：", 消息);
    }
}
